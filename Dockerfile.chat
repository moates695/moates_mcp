FROM python:3.12-slim

# uv for fast, reproducible installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src

# Install the package with the chat extras (fastapi + openai).
RUN uv pip install --system --no-cache ".[chat]"

ENV CHAT_HOST=0.0.0.0 \
    CHAT_PORT=8000
EXPOSE 8000

# One uvicorn worker is plenty for portfolio traffic and keeps the in-memory
# rate-limit counters coherent (they are per-process).
CMD ["uvicorn", "moates_chat.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
