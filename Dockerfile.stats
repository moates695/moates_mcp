FROM python:3.12-slim

# uv for fast, reproducible installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src

# Install the package with the stats extras (fastapi + psycopg).
RUN uv pip install --system --no-cache ".[stats]"

ENV STATS_HOST=0.0.0.0 \
    STATS_PORT=8000
EXPOSE 8000

# One uvicorn worker. Portfolio traffic needs nothing more, it keeps the
# in-memory rate-limit counters coherent (they are per-process), and it holds
# the connection pool to a single small set of Postgres backends.
CMD ["uvicorn", "moates_stats.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
